{
  "name": "microservices",
  "private": true,
  "workspaces": [
    "auth-service",
    "user-service",
    "lead-service",
    "call-service",
    "media-service",
    "notification-service",
    "Telecaller-service"
  ],
  "scripts": {
    "nx": "nx",
    "graph": "nx graph",
    "dev": "nx run-many -t serve -p auth-service user-service lead-service call-service media-service notification-service telecaller-service --parallel --output-style=stream",
    "start": "nx run-many -t start:prod -p auth-service user-service lead-service call-service media-service notification-service telecaller-service --parallel --output-style=stream",
    "build:all": "nx run-many -t build -p auth-service user-service lead-service call-service media-service notification-service telecaller-service --parallel",
    "dev:auth": "nx serve auth-service",
    "dev:user": "nx serve user-service",
    "dev:lead": "nx serve lead-service",
    "dev:call": "nx serve call-service",
    "dev:media": "nx serve media-service",
    "dev:notification": "nx serve notification-service",
    "dev:telecaller": "nx serve telecaller-service",
    "start:auth": "nx start:prod auth-service",
    "start:user": "nx start:prod user-service",
    "start:lead": "nx start:prod lead-service",
    "start:call": "nx start:prod call-service",
    "start:media": "nx start:prod media-service",
    "start:notification": "nx start:prod notification-service",
    "start:telecaller": "nx start:prod telecaller-service"
  },
  "devDependencies": {
    "nx": "^20.1.1",
    "@nx/nest": "^20.1.1",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.5",
    "@types/bcrypt": "^6.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mongoose": "^5.11.96",
    "@types/multer": "^1.4.11",
    "@types/node": "^22.10.7",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.2",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.7",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.450.0",
    "@aws-sdk/s3-request-presigner": "^3.450.0",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.1.5",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.5",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/microservices": "^11.1.6",
    "@nestjs/mongoose": "^11.0.3",
    "@nestjs/platform-express": "^11.1.5",
    "@nestjs/schedule": "^6.0.1",
    "@nestjs/swagger": "^11.2.0",
    "axios": "^1.12.2",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.2.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.17.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^9.0.1",
    "xlsx": "^0.18.5"
  }
}
