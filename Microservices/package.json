{
  "name": "microservices",
  "private": true,
  "workspaces": [
    "auth-service",
    "user-service",
    "lead-service",
    "call-service",
    "media-service",
    "notification-service",
    "Telecaller-service"
  ],
  "scripts": {
    "nx": "nx",
    "graph": "nx graph",
    "start:all": "nx run-many -t serve -p auth-service user-service lead-service call-service media-service notification-service telecaller-service --parallel",
    "build:all": "nx run-many -t build -p auth-service user-service lead-service call-service media-service notification-service telecaller-service --parallel",
    "start:auth": "nx serve auth-service",
    "start:user": "nx serve user-service",
    "start:lead": "nx serve lead-service",
    "start:call": "nx serve call-service",
    "start:media": "nx serve media-service",
    "start:notification": "nx serve notification-service",
    "start:telecaller": "nx serve telecaller-service"
  },
  "devDependencies": {
    "nx": "^20.1.1",
    "@nx/nest": "^20.1.1",
    "typescript": "^5.7.3",
    "ts-node": "^10.9.2",
    "jest": "^30.0.0",
    "ts-jest": "^29.2.5",
    "@types/jest": "^30.0.0",
    "cross-env": "^7.0.3"
  },
  "dependencies": {
    "@nestjs/mongoose": "^11.0.3",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.17.0"
  }
}
